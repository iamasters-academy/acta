{
  "name": "acta",
  "version": "0.1.0",
  "private": true,
  "description": "Acta — cuaderno de reuniones con IA, local (inspirado en Granola)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/index.ts --dev",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:payload": "node scripts/build-payload.mjs",
    "build:native": "bash native/build.sh",
    "build:native:win": "node scripts/build-win-helper.mjs",
    "start": "node server/index.ts",
    "app": "electron .",
    "mcp": "node server/mcp.ts",
    "package:mac": "bash scripts/package-mac.sh",
    "package:win": "node scripts/package-win.mjs",
    "smoke": "node scripts/smoke-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "express": "^5.1.0",
    "ical-expander": "^3.1.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.1",
    "@electron/packager": "^18.3.0",
    "@electron/universal": "^2.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tiptap/extension-list": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.500.0",
    "marked": "^15.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.1.0",
    "turndown": "^7.2.4",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.28.2": true
  }
}
